<?xml version="1.0"?>
<!--
  Unraid container template for StoryTime.

  Easiest install: in Unraid go to Docker > Add Container, and in the Template dropdown paste
  https://raw.githubusercontent.com/tfProxy/StoryTime/main/unraid/storytime.xml
  (or copy this file to /boot/config/plugins/dockerMan/templates-user/ and pick "storytime").

  The image is published to GitHub's container registry by .github/workflows/docker.yml. If the
  package is private, run `docker login ghcr.io` once on the server with a GitHub token that has
  the read:packages scope.
-->
<Container version="2">
  <Name>storytime</Name>
  <Repository>ghcr.io/tfproxy/storytime:latest</Repository>
  <Registry>https://github.com/tfProxy/StoryTime/pkgs/container/storytime</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/tfProxy/StoryTime/issues</Support>
  <Project>https://github.com/tfProxy/StoryTime</Project>
  <Overview>StoryTime: write branching, choose-your-own-adventure stories together, with optional AI help. Everyone brings their own AI key (kept in their browser), so the server needs no AI credentials. Stories are stored in a single SQLite file in the appdata folder.</Overview>
  <Category>Other:</Category>
  <WebUI>http://[IP]:[PORT:3000]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/tfProxy/StoryTime/main/unraid/storytime.xml</TemplateURL>
  <Icon/>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Web UI port" Target="3000" Default="3000" Mode="tcp" Description="Port the site is served on." Type="Port" Display="always" Required="true" Mask="false">3000</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/storytime" Mode="rw" Description="Where the database lives. Include this folder in your appdata backups." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/storytime</Config>
  <Config Name="Admin password" Target="ADMIN_PASSWORD" Default="" Mode="" Description="Turns on the /admin moderation page. Leave blank to switch it off." Type="Variable" Display="always" Required="false" Mask="true"/>
</Container>
